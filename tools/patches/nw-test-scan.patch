+/* Board-side diagnostic: start one scan on the primary interface without a
+ * control-socket client. The control path above still works when a client is
+ * attached; this is only for bringing up an endpoint whose userspace has not
+ * connected yet. */
+int nw_cfg80211_scan_all(void) {
+  if (!primary) return -ENODEV;
+  if (!netif_running(primary)) {
+    rtnl_lock();
+    int opened = dev_open(primary, NULL);
+    rtnl_unlock();
+    if (opened) return opened;
+  }
+  struct cfg80211_registered_device *rdev = wiphy_to_rdev(primary->ieee80211_ptr->wiphy);
+  struct nw_control_view view;
+  memset(&view, 0, sizeof(view));
+  return scan(rdev, &view);
+}
