+static void
+fk_tccdiag_probe(proc_t p)
+{
+	const char *n = p->p_comm;
+	if (!n) {
+		return;
+	}
+	void *blob = NULL;
+	size_t len = 0;
+	int rc = cs_entitlements_blob_get(p, &blob, &len);
+	printf("FUXI TCC: pid %d %s flags %#x ent rc=%d len=%lu blob=%p\n",
+	    p->p_pid, n, proc_getcsflags(p), rc, (unsigned long)len, blob);
